# Copia este archivo como ".env" y completa tus datos. El archivo .env NO se sube a Git.

# "sqlserver" usa la base de datos; si lo quitas, la API usa memoria (se pierde al reiniciar).
DB_DRIVER=sqlserver

# Para Supabase PostgreSQL: usa DB_DRIVER=postgres y configura DATABASE_URL con
# Supabase > Connect > Transaction pooler (puerto 6543). No subas la URL real a Git.
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# PG_POOL_MAX=1 (recomendado para Vercel/serverless)

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BodegasDB
DB_USER=sa
DB_PASSWORD=cambia-esta-contraseña

# Máximo de conexiones simultáneas a SQL Server (por defecto 150).
DB_POOL_MAX=150
# Conexiones que se abren al arrancar y se mantienen abiertas (por defecto 0). Con una carga alta
# conviene un valor cercano al máximo: evita la ráfaga de inicios de sesión que provoca
# "Failed to connect to localhost:1433 in 15000ms".
DB_POOL_MIN=0
# Milisegundos de espera para completar una conexión nueva (por defecto 15000).
DB_CONNECTION_TIMEOUT=15000

# Cifrado de la conexión. Si no defines DB_ENCRYPT, se usa el valor por defecto del driver (cifrado activado).
# Para SQL Server local, confiar en el certificado en true.
# DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

PORT=3000
