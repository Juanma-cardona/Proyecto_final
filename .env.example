# Copia este archivo como ".env" y completa tus datos. El archivo .env NO se sube a Git.

# "sqlserver" usa la base de datos; si lo quitas, la API usa memoria (se pierde al reiniciar).
DB_DRIVER=sqlserver

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BodegasDB
DB_USER=sa
DB_PASSWORD=cambia-esta-contraseña

# Para SQL Server local: encrypt en false y confiar en el certificado en true.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

PORT=3000
